<Window x:Class="GradleDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:GradleDoctor"
        Title="Gradle Doctor"
        Icon="Assets/GradleDoctor.ico"
        Height="880" Width="1320"
        MinHeight="720" MinWidth="1120"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="SkipChipTemplate">
            <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                            Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource TextMutedBrush}"
                            Width="16" Height="16" Padding="0" Margin="5,0,0,0" Tag="{Binding}"
                            Click="RemoveSkipChip_Click" ToolTip="Remove folder" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowRoot" Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= CUSTOM TITLE BAR ================= -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,9,0">
                            <Path Data="M 10 18 L 10 22 L 14 22 L 14 18 L 18 18 L 18 14 L 14 14 L 14 10 L 10 10 L 10 14 L 6 14 L 6 18 Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Gradle Doctor" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBarTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="  /  Gradle &amp; AGP manager" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Compatibility-first wrapper updates"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ComboBox x:Name="ThemeCombo" Width="96" Height="28" Margin="0,0,10,0"
                                  VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged"
                                  ToolTip="Application theme">
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                            <ComboBoxItem Content="System" Tag="System" />
                        </ComboBox>
                        <Button x:Name="MinBtn" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="MaxBtn" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}" Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= BODY ================= -->
            <Grid Grid.Row="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Brand header -->
                    <RowDefinition Height="Auto" /> <!-- Folder -->
                    <RowDefinition Height="Auto" /> <!-- Settings -->
                    <RowDefinition Height="Auto" /> <!-- Toolbar -->
                    <RowDefinition Height="*" />    <!-- Projects + details -->
                    <RowDefinition Height="9" />    <!-- Terminal splitter -->
                    <RowDefinition x:Name="TerminalRow" Height="170" MinHeight="42" /> <!-- Terminal -->
                    <RowDefinition Height="Auto" /> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Brand header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,13,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#2563EB" Opacity="0.28" BlurRadius="12" ShadowDepth="3" Direction="270" />
                        </Border.Effect>
                        <Path Data="M 10 18 L 10 22 L 14 22 L 14 18 L 18 18 L 18 14 L 14 14 L 14 10 L 10 10 L 10 14 L 6 14 L 6 18 Z"
                              Fill="#FFFFFF" Stretch="Uniform" Width="22" Height="22"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gradle Doctor" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border CornerRadius="5" Background="{DynamicResource SuccessLightBrush}" Padding="7,2" Margin="9,3,0,0">
                                <TextBlock Text="1.1" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Compatibility-aware Gradle &amp; Android Gradle Plugin updates for Android and Flutter projects."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="15" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 12 2 C 8.13 2 5 5.13 5 9 C 5 14.25 12 22 12 22 C 12 22 19 14.25 19 9 C 19 5.13 15.87 2 12 2 Z"
                                      Fill="{DynamicResource PrimaryBrush}" Width="11" Height="11" Stretch="Uniform"
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="HomeBadgeText" Text="Gradle Home" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="15" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1" Padding="12,6">
                            <TextBlock x:Name="ProjectCountBadge" Text="0 projects" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Folder card -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Path Data="M 2 4 C 2 2.9 2.9 2 4 2 L 8 2 L 10 4 L 18 4 C 19.1 4 20 4.9 20 6 L 20 16 C 20 17.1 19.1 18 18 18 L 4 18 C 2.9 18 2 17.1 2 16 L 2 4 Z"
                                  Fill="{DynamicResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Projects folder" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox x:Name="PathBox" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"
                                 Padding="10,7" ToolTip="Folder containing your Android or Flutter projects" />
                        <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="16,7" Click="Browse_Click" />
                        <Button x:Name="ScanBtn" Grid.Column="3" Content="Scan projects" Margin="8,0,0,0"
                                Padding="18,7" Style="{StaticResource PrimaryButtonStyle}" Click="Scan_Click" />
                    </Grid>
                </Border>

                <!-- Settings -->
                <Expander x:Name="SettingsExpander" Grid.Row="2" Margin="0,0,0,10"
                          Expanded="SettingsExpander_Expanded" Collapsed="SettingsExpander_Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3 6 L 15 6 M 3 12 L 21 12 M 3 18 L 9 18 M 15 4 L 15 8 M 9 10 L 9 14 M 18 16 L 18 20"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings &amp; environment" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Gradle home, scan filters, build verification" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>

                    <ScrollViewer x:Name="SettingsScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gradle home" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top"
                                           Margin="0,7,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="GradleHomeBox"
                                             ToolTip="Empty = auto-detect (GRADLE_USER_HOME or %USERPROFILE%\.gradle)" />
                                    <TextBlock x:Name="GradleHomeHint" FontSize="10.5" FontFamily="{DynamicResource MonoFont}"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="12,6"
                                        VerticalAlignment="Top" Click="BrowseHome_Click" />
                                <Button Grid.Column="3" Content="Auto" Margin="8,0,0,0" Padding="12,6"
                                        VerticalAlignment="Top" Click="ResetHome_Click"
                                        ToolTip="Clear the custom path and use the auto-detected Gradle home" />
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource WindowBgAltBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,10" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Skip folders" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Folder names ignored while scanning. Add a name, not a full path."
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="SkipChips" ItemTemplate="{StaticResource SkipChipTemplate}"
                                                  Margin="0,8,0,2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="SkipInput" KeyDown="SkipInput_KeyDown"
                                                     TextChanged="SkipInput_TextChanged"
                                                     ToolTip="Type a folder name, then press Enter or Add" />
                                            <TextBlock x:Name="SkipInputHint" Text="Folder name, e.g. .git"
                                                       IsHitTestVisible="False" Margin="11,0,0,0"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                        <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="12,6"
                                                Click="AddSkip_Click" />
                                        <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0" Padding="12,6"
                                                Click="ResetSkip_Click" ToolTip="Restore the default skip folders" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default target" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <ComboBox x:Name="DefaultTargetBox" Grid.Column="1"
                                          ToolTip="Default Gradle version used for new scans"
                                          AutomationProperties.Name="Default Gradle version"
                                          SelectionChanged="DefaultTargetBox_SelectionChanged"
                                          ItemTemplate="{StaticResource VersionOptionTemplate}" />
                                <Button x:Name="UseDefaultBtn" Grid.Column="2" Content="Use as target for selected"
                                        Margin="8,0,0,0" Padding="12,6" Click="UseDefault_Click" />
                                <TextBlock Grid.Column="3" Text="The latest stable release is used when no default is chosen."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>

                            <WrapPanel Grid.Row="3">
                                <CheckBox x:Name="UpdateAgpCheck" Content="Auto-update AGP to newest compatible"
                                          IsChecked="True" Margin="0,0,22,8"
                                          ToolTip="Detects AGP in settings/build files and libs.versions.toml, then suggests the newest compatible version" />
                                <CheckBox x:Name="VerifyCheck" Content="Build after update"
                                          Margin="0,0,16,8"
                                          ToolTip="Runs verification build (e.g. assembleDebug) after updating versions" />
                                <CheckBox x:Name="RollbackCheck" Content="Roll back on build failure"
                                          Margin="0,0,22,8"
                                          ToolTip="If checked, reverts changes to previous version if the test build fails. If unchecked, keeps updated files so you can inspect and fix errors." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                    <TextBlock Text="Task" FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBox x:Name="TaskBox" Width="132" Padding="8,5" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                    <TextBlock Text="Timeout" FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBox x:Name="TimeoutBox" Width="56" Padding="8,5"
                                             HorizontalContentAlignment="Center" />
                                    <TextBlock Text="min" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                                <Button Content="Edit compatibility rules" Margin="0,0,0,8" Padding="12,6"
                                        Click="EditCompat_Click" />
                            </WrapPanel>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <!-- Toolbar -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,9,12,1" Margin="0,0,0,10">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,8">
                            <TextBlock Text="Target Gradle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TargetBox" Width="104" Padding="8,6" FontFamily="{DynamicResource MonoFont}"
                                     ToolTip="Target Gradle version, e.g. 9.8.2"
                                     LostFocus="TargetBox_LostFocus"
                                     KeyDown="TargetBox_KeyDown" />
                            <ComboBox x:Name="VersionPicker" Width="150" Margin="6,0,0,0"
                                      SelectionChanged="VersionPicker_SelectionChanged"
                                      AutomationProperties.Name="Gradle version picker"
                                      ItemTemplate="{StaticResource VersionOptionTemplate}"
                                      ToolTip="Pick a stable, installed, or project version" />
                            <Button x:Name="RefreshVersionsBtn" Content="Refresh" Margin="6,0,0,0" Padding="10,6" Click="RefreshVersions_Click"
                                    ToolTip="Fetch the latest stable Gradle versions" />
                            <Button x:Name="DownloadBtn" Content="Prepare" Margin="6,0,0,0" Padding="10,6" Click="Download_Click"
                                    ToolTip="Download the target distribution into the selected Gradle home" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,8">
                            <Button x:Name="SelAllBtn" Content="Select all" Margin="0,0,6,0" Click="SelectAll_Click" />
                            <Button x:Name="SelNoneBtn" Content="Select none" Margin="0,0,6,0" Click="SelectNone_Click" />
                            <Button x:Name="SetTargetBtn" Content="Set target" Click="SetTarget_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,8">
                            <Button x:Name="DryBtn" Content="Dry run" Margin="0,0,6,0" Padding="16,7" Click="DryRun_Click" />
                            <Button x:Name="ApplyBtn" Content="Apply selected" Padding="16,7"
                                    Style="{StaticResource SuccessButtonStyle}" Click="Apply_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Button x:Name="CleanBtn" Content="Clean old versions..." Margin="0,0,6,0" Click="Clean_Click" />
                            <Button x:Name="StopBtn" Content="Stop daemons" Padding="14,7" Style="{StaticResource DangerButtonStyle}" Click="Stop_Click" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Projects + details -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition x:Name="DetailsColumn" Width="330" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Discovered projects" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="10" Padding="7,1" Margin="9,0,0,0">
                                            <TextBlock x:Name="SummarySelected" Text="0 selected" FontSize="10.5"
                                                       Foreground="{DynamicResource BadgeTextBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="SummaryChanges" Text="0 changes" FontSize="10.5"
                                                       Foreground="{DynamicResource WarningForegroundBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource DangerLightBrush}" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="SummaryWarnings" Text="0 warnings" FontSize="10.5"
                                                       Foreground="{DynamicResource DangerForegroundBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="SearchBox" Width="170" Padding="8,5" Margin="0,0,6,0"
                                                 TextChanged="SearchBox_TextChanged" ToolTip="Filter by project name or path" />
                                        <ComboBox x:Name="FilterCombo" Width="112" SelectedIndex="0"
                                                  SelectionChanged="FilterCombo_SelectionChanged" ToolTip="Filter by type">
                                            <ComboBoxItem Content="All types" Tag="All" />
                                            <ComboBoxItem Content="Android" Tag="Android" />
                                            <ComboBoxItem Content="Flutter" Tag="Flutter" />
                                        </ComboBox>
                                        <Button x:Name="DetailsToggleBtn" Content="Details" Margin="6,0,0,0"
                                                Padding="10,6" Click="DetailsToggle_Click" ToolTip="Show or hide project details" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid>
                                <DataGrid x:Name="ProjectsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" SelectionMode="Single" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionChanged="ProjectsGrid_SelectionChanged"
                                          CellEditEnding="ProjectsGrid_CellEditEnding"
                                          MouseDoubleClick="ProjectsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="42" MinWidth="42">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Project" Width="170" MinWidth="170" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M 3 4 C 3 2.9 3.9 2 5 2 L 9 2 L 11 4 L 19 4 C 20.1 4 21 4.9 21 6 L 21 16 C 21 17.1 20.1 18 19 18 L 5 18 C 3.9 18 3 17.1 3 16 Z"
                                                              Fill="{DynamicResource PrimaryBrush}" Opacity="0.8" Width="13" Height="13"
                                                              Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Type" Width="76" MinWidth="76" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="TypePill" CornerRadius="5" Padding="7,2"
                                                            HorizontalAlignment="Left" Background="{DynamicResource SuccessLightBrush}">
                                                        <TextBlock x:Name="TypeText" Text="{Binding Type}" FontSize="10"
                                                                   FontWeight="Bold" Foreground="{DynamicResource SuccessForegroundBrush}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Flutter">
                                                            <Setter TargetName="TypePill" Property="Background" Value="{DynamicResource InfoLightBrush}" />
                                                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource InfoForegroundBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Gradle" Binding="{Binding CurrentGradle}" Width="68" MinWidth="68" IsReadOnly="True"
                                                            FontFamily="{DynamicResource MonoFont}" FontWeight="Medium" />
                                        <DataGridTextColumn Header="AGP" Binding="{Binding Agp}" Width="68" MinWidth="68" IsReadOnly="True"
                                                            FontFamily="{DynamicResource MonoFont}" FontWeight="Medium" />
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target, UpdateSourceTrigger=LostFocus}"
                                                            Width="102" MinWidth="102" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold"
                                                            EditingElementStyle="{StaticResource GridEditTextBox}" />
                                        <DataGridTextColumn Header="Target AGP" Binding="{Binding TargetAgp, UpdateSourceTrigger=LostFocus}"
                                                            Width="100" MinWidth="100" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold"
                                                            EditingElementStyle="{StaticResource GridEditTextBox}" />

                                        <DataGridTemplateColumn Header="Status" Width="136" MinWidth="136" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="StatusPill" CornerRadius="5" Padding="7,2" HorizontalAlignment="Left"
                                                            Background="{DynamicResource SuccessLightBrush}"
                                                            Visibility="{Binding Status, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="10.5"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Will change">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource WarningLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Updating...">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Building...">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Updated">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SuccessLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Updated, build OK">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SuccessLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rolled back">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource DangerLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource DangerLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Bad target">
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource DangerLightBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Warning" Width="190" MinWidth="190" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M 1 21 L 23 21 L 12 2 Z M 12 18 A 1 1 0 1 1 12 16 A 1 1 0 0 1 12 18 Z M 11 10 L 13 10 L 13 14 L 11 14 Z"
                                                              Fill="{DynamicResource WarningBrush}" Width="12" Height="12" Stretch="Uniform"
                                                              Margin="0,0,6,0" Visibility="{Binding Warning, Converter={StaticResource StringNotEmptyToVisibility}}" />
                                                        <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarningForegroundBrush}"
                                                                   FontWeight="Medium" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Warning}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="130" IsReadOnly="True"
                                                            Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border x:Name="EmptyState" Background="{DynamicResource CardBgBrush}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 2 4 C 2 2.9 2.9 2 4 2 L 8 2 L 10 4 L 18 4 C 19.1 4 20 4.9 20 6 L 20 16 C 20 17.1 19.1 18 18 18 L 4 18 C 2.9 18 2 17.1 2 16 Z"
                                              Fill="{DynamicResource TextMutedBrush}" Width="38" Height="38" Stretch="Uniform"
                                              HorizontalAlignment="Center" Opacity="0.6" />
                                        <TextBlock Text="No projects scanned yet" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                                        <TextBlock Text="Choose a folder and click Scan projects." FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

                    <Border x:Name="DetailsPanel" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <TextBlock Text="Project details" FontSize="12.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GhostButtonStyle}"
                                            Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="DetailsToggle_Click"
                                            ToolTip="Hide details" />
                                </Grid>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                    Padding="14,8" Visibility="{Binding ElementName=DetailContent, Path=Visibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OpenFolderBtn" Content="Open folder" Margin="0,0,3,0"
                                            Padding="6,6" Click="OpenFolder_Click" />
                                    <Button x:Name="CopyPathBtn" Grid.Column="1" Content="Copy path"
                                            Margin="3,0,3,0" Padding="6,6" Click="CopyPath_Click" />
                                    <Button x:Name="SelectOnlyBtn" Grid.Column="2" Content="Select only"
                                            Margin="3,0,0,0" Padding="6,6" Click="SelectOnly_Click" />
                                </Grid>
                            </Border>

                            <Grid>
                                <TextBlock x:Name="DetailEmpty" Text="Select a project to inspect its versions."
                                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,0" />

                                <ScrollViewer x:Name="DetailContent" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="14,10,14,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,10,0">
                                                <Path Data="M 3 4 C 3 2.9 3.9 2 5 2 L 9 2 L 11 4 L 19 4 C 20.1 4 21 4.9 21 6 L 21 16 C 21 17.1 20.1 18 19 18 L 5 18 C 3.9 18 3 17.1 3 16 Z"
                                                      Fill="{DynamicResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="DetailName" FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="DetailType" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Background="{DynamicResource WindowBgAltBrush}" CornerRadius="7" Padding="9,7" Margin="0,10,0,10">
                                            <TextBlock x:Name="DetailPath" FontSize="10.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </Border>

                                        <Border x:Name="DetailWarningBorder" Background="{DynamicResource WarningLightBrush}" CornerRadius="7"
                                                Padding="9,7" Margin="0,0,0,10" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,0,7,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock x:Name="DetailWarning" Grid.Column="1" TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource WarningForegroundBrush}" />
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="CURRENT GRADLE" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="TARGET GRADLE" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                            <TextBlock x:Name="DetailGradle" Grid.Row="1" FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock x:Name="DetailTargetGradle" Grid.Row="1" Grid.Column="1"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}" />

                                            <TextBlock Grid.Row="2" Text="Current AGP" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,9,8,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Target AGP" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,9,0,0" />

                                            <TextBlock x:Name="DetailAgp" Grid.Row="3" FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock x:Name="DetailTargetAgp" Grid.Row="3" Grid.Column="1"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                        </Grid>

                                        <Border Background="{DynamicResource WindowBgAltBrush}" CornerRadius="7" Padding="9,7" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DetailStatusDot" Width="7" Height="7"
                                                         Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DetailStatus" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Terminal splitter -->
                <Grid Grid.Row="5" Margin="0,2,0,2">
                    <Border Height="1" Background="{DynamicResource TerminalSplitterBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <Thumb x:Name="TerminalSplitter" Height="9" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Background="Transparent" Cursor="SizeNS" DragDelta="TerminalSplitter_DragDelta"
                           ToolTip="Drag to resize the log">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>

                <!-- Terminal -->
                <Border Grid.Row="6" Background="{DynamicResource TerminalBgBrush}" BorderBrush="{DynamicResource TerminalBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource TerminalHeaderBrush}" BorderBrush="{DynamicResource TerminalBorderBrush}"
                                BorderThickness="0,0,0,1" Padding="12,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 4 6 L 10 12 L 4 18 M 12 18 L 20 18" Stroke="{DynamicResource TerminalAccentBrush}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Execution &amp; diagnostic log" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TerminalHeaderTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LogEmpty" Text="  Ready" FontSize="10.5"
                                               Foreground="{DynamicResource TerminalMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="TerminalToggleBtn" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Height="24" Margin="0,0,6,0"
                                            AutomationProperties.Name="Toggle log" Click="TerminalToggle_Click" ToolTip="Collapse log" />
                                    <Button Content="Copy" Click="CopyLog_Click" Style="{StaticResource GhostButtonStyle}"
                                            Foreground="{DynamicResource TerminalActionBrush}" Padding="9,3" Margin="2,0,0,0" FontSize="11" />
                                    <Button Content="Save" Click="SaveLog_Click" Style="{StaticResource GhostButtonStyle}"
                                            Foreground="{DynamicResource TerminalActionBrush}" Padding="9,3" Margin="2,0,0,0" FontSize="11" />
                                    <Button Content="Clear" Click="ClearLog_Click" Style="{StaticResource GhostButtonStyle}"
                                            Foreground="{DynamicResource TerminalActionBrush}" Padding="9,3" Margin="2,0,0,0" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource TerminalTextBoxStyle}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="7" Margin="2,7,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="Choose your projects folder, then click Scan." />
                    </StackPanel>

                    <TextBlock x:Name="HomeLabel" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Loading overlay / Floating progress card -->
            <Grid x:Name="BusyOverlay" Grid.RowSpan="2" Background="Transparent"
                  Visibility="Collapsed" Panel.ZIndex="50" IsHitTestVisible="False">
                <Border x:Name="BusyCard" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16" Width="410"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}"
                        IsHitTestVisible="True" MouseLeftButtonDown="BusyCard_MouseLeftButtonDown"
                        MouseMove="BusyCard_MouseMove" MouseLeftButtonUp="BusyCard_MouseLeftButtonUp">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BusyCardTransform" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <!-- Header with title and minimize button -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12 2 C 8.13 2 5 5.13 5 9 C 5 14.25 12 22 12 22 C 12 22 19 14.25 19 9 C 19 5.13 15.87 2 12 2 Z"
                                      Fill="{DynamicResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform"
                                      Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BusyText" Text="Working..." FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="BusyMiniToggleBtn" Grid.Column="1" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource GhostButtonStyle}" Width="26" Height="26" Padding="0"
                                    Click="BusyMiniToggle_Click" ToolTip="Minimize / Expand progress card" Cursor="Arrow" />
                        </Grid>

                        <!-- Body (collapsible) -->
                        <StackPanel x:Name="BusyExpandedContent">
                            <TextBlock x:Name="BusyDetailText" Text="" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,8" TextTrimming="CharacterEllipsis" MaxWidth="370"
                                       Visibility="Collapsed" />
                            <Grid Margin="0,4,0,4">
                                <ProgressBar x:Name="BusyProgress" Style="{StaticResource ModernProgressBarStyle}"
                                             Height="8" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True" />
                            </Grid>
                            <Grid Margin="0,2,0,10">
                                <TextBlock x:Name="BusyCountText" Text="" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="BusyPercentText" Text="" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"
                                           Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>

                        <!-- Footer -->
                        <Button x:Name="CancelBtn" Content="Cancel" HorizontalAlignment="Center" Padding="16,5"
                                Margin="0,2,0,0" Click="Cancel_Click" Cursor="Arrow" />
                    </StackPanel>
                </Border>
            </Grid>

            <local:ToastHost x:Name="ToastHostControl" Grid.RowSpan="2" Panel.ZIndex="100"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,54" />
        </Grid>
    </Border>
</Window>
