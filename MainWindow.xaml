<Window x:Class="GradleDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gradle Doctor" Height="760" Width="1150"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Projects folder -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Projects folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="PathBox" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Padding="6" />
            <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="16,6" Click="Browse_Click" />
            <Button x:Name="ScanBtn" Grid.Column="3" Content="Scan" Margin="8,0,0,0" Padding="16,6" Click="Scan_Click" />
        </Grid>

        <!-- Settings -->
        <Expander Grid.Row="1" Header="Settings (everything here is yours to change)" Margin="0,0,0,8">
            <Grid Margin="8,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Gradle home:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="GradleHomeBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Padding="4"
                         ToolTip="Empty = auto-detect (GRADLE_USER_HOME or %USERPROFILE%\.gradle)" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="8,0,0,6" Padding="12,3" Click="BrowseHome_Click" />
                <Button Grid.Row="0" Grid.Column="3" Content="Auto" Margin="8,0,0,6" Padding="12,3" Click="ResetHome_Click" />

                <TextBlock Grid.Row="1" Text="Skip folders:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="SkipBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6" Padding="4"
                         ToolTip="Comma separated folder names ignored while scanning" />

                <TextBlock Grid.Row="2" Text="Always keep:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="KeepBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6" Padding="4"
                         ToolTip="Comma separated Gradle versions that cleanup must never delete, e.g. 8.14, 9.1.0" />

                <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,2,0,6">
                    <CheckBox x:Name="VerifyCheck" Content="Build after update, roll back on failure"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Task:" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBox x:Name="TaskBox" Width="140" Padding="4" />
                    <TextBlock Text="Timeout (min):" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBox x:Name="TimeoutBox" Width="50" Padding="4" />
                    <Button Content="Edit compatibility rules" Margin="14,0,0,0" Padding="12,3" Click="EditCompat_Click" />
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Actions -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Target Gradle:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="TargetBox" Width="110" IsEditable="True" Margin="0,0,10,0" />
            <Button x:Name="SelAllBtn" Content="Select all" Margin="0,0,6,0" Padding="12,6" Click="SelectAll_Click" />
            <Button x:Name="SelNoneBtn" Content="Select none" Margin="0,0,6,0" Padding="12,6" Click="SelectNone_Click" />
            <Button x:Name="SetTargetBtn" Content="Set target on selected" Margin="0,0,14,0" Padding="12,6" Click="SetTarget_Click" />
            <Button x:Name="DryBtn" Content="Dry Run" Margin="0,0,6,0" Padding="14,6" Click="DryRun_Click" />
            <Button x:Name="ApplyBtn" Content="Apply to selected" Margin="0,0,6,0" Padding="14,6" Click="Apply_Click" />
            <Button x:Name="CleanBtn" Content="Clean old versions..." Margin="0,0,6,0" Padding="14,6" Click="Clean_Click" />
            <Button x:Name="StopBtn" Content="Stop Gradle daemons" Padding="14,6" Click="Stop_Click" />
        </WrapPanel>

        <!-- Projects -->
        <DataGrid x:Name="ProjectsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" AlternatingRowBackground="#F4F4F4" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="65" IsReadOnly="True" />
                <DataGridTextColumn Header="Gradle" Binding="{Binding CurrentGradle}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="AGP" Binding="{Binding Agp}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Target (editable)" Binding="{Binding Target, UpdateSourceTrigger=LostFocus}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="230" IsReadOnly="True" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Log -->
        <TextBox x:Name="LogBox" Grid.Row="4" Margin="0,10,0,0" IsReadOnly="True"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,8,0,0" Foreground="Gray"
                   Text="Choose your projects folder, then click Scan." />
    </Grid>
</Window>
