<Window x:Class="GradleDoctor.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gradle Doctor"
        Width="500"
        MinHeight="190"
        MaxHeight="680"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Border x:Name="RootCard" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBg" Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                            Margin="18,18,12,10" Background="{DynamicResource PrimaryLightBrush}">
                        <Path x:Name="IconPath" Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource PrimaryBrush}" />
                    </Border>

                    <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                               FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource GhostButtonStyle}" Width="32" Height="32"
                            Margin="0,10,12,0" VerticalAlignment="Top" Click="Close_Click"
                            ToolTip="Close" />
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="390" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="20,4,20,4">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Padding="18,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SecondaryBtn" Content="Cancel" Margin="0,0,8,0"
                                Padding="16,7" Click="Secondary_Click" />
                        <Button x:Name="PrimaryBtn" Content="OK" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="18,7" Click="Primary_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
