<Window x:Class="GradleDoctor.ApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review changes"
        Width="780"
        Height="640"
        MinHeight="520"
        MinWidth="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="11" Margin="18,18,12,12"
                            Background="{DynamicResource SuccessLightBrush}">
                        <Path Data="M 4 12 L 9 17 L 20 6" Stroke="{DynamicResource SuccessBrush}"
                              StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Review update plan" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource GhostButtonStyle}" Width="32" Height="32"
                            Margin="0,10,12,0" VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Close" />
                </Grid>

                <Grid Grid.Row="1" Margin="18,2,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource WindowBgAltBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="PROJECTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="ProjectsCount" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource PrimaryLightBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="GRADLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock x:Name="GradleCount" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource InfoLightBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="AGP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" />
                            <TextBlock x:Name="AgpCount" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource WarningLightBrush}" CornerRadius="8" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="WARNINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningForegroundBrush}" />
                            <TextBlock x:Name="WarningsCount" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="18,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="WarningBanner" Grid.Row="0" Background="{DynamicResource WarningLightBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,0"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource WarningForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                        <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" RowHeight="36" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project" Binding="{Binding Project.Name}" Width="170" />
                                <DataGridTextColumn Header="Gradle" Binding="{Binding GradleChange}" Width="160"
                                                    FontFamily="{DynamicResource MonoFont}" />
                                <DataGridTextColumn Header="AGP" Binding="{Binding AgpChange}" Width="140"
                                                    FontFamily="{DynamicResource MonoFont}" />
                                <DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="VerifyText" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="BackupText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="ExtraText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource WarningForegroundBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Padding="18,12" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock Text="A .gradledoctor.bak copy is created only for files that change."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Margin="0,0,8,0" Padding="16,7" Click="Cancel_Click" />
                            <Button x:Name="ApplyBtn" Content="Apply changes" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="18,7" Click="Apply_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
