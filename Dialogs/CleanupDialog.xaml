<Window x:Class="GradleDoctor.CleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean Gradle cache &amp; distributions"
        Width="920"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="11" Margin="18,18,12,12"
                            Background="{DynamicResource DangerLightBrush}">
                        <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 Z"
                              Fill="{DynamicResource DangerBrush}" Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Clean old Gradle versions" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Versions used by scanned projects are never listed. Select what you no longer need."
                                   FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource GhostButtonStyle}" Width="32" Height="32"
                            Margin="0,10,12,0" VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Close" />
                </Grid>

                <Grid Grid.Row="1" Margin="18,2,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource WindowBgAltBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="SELECTED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="SelectedCount" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SuccessLightBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TO RECLAIM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessForegroundBrush}" />
                            <TextBlock x:Name="SelectedSize" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessForegroundBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource InfoLightBrush}" CornerRadius="8" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="AVAILABLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource InfoForegroundBrush}" />
                            <TextBlock x:Name="TotalCount" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InfoForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="18,0,18,0" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                    <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" RowHeight="42" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Kind" Width="115" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="KindPill" CornerRadius="5" Padding="7,2" HorizontalAlignment="Left"
                                                Background="{DynamicResource InfoLightBrush}">
                                            <TextBlock x:Name="KindText" Text="{Binding KindLabel}" FontSize="10"
                                                       FontWeight="Bold" Foreground="{DynamicResource InfoForegroundBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="cache">
                                                <Setter TargetName="KindPill" Property="Background" Value="{DynamicResource WarningLightBrush}" />
                                                <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" IsReadOnly="True"
                                                FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" IsReadOnly="True"
                                                FontFamily="{DynamicResource MonoFont}" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"
                                                Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Padding="18,12" Margin="0,14,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="RecycleCheck" Content="Send to Recycle Bin" IsChecked="True"
                                      VerticalAlignment="Center" Checked="Recycle_Changed" Unchecked="Recycle_Changed" />
                            <TextBlock x:Name="HintText" Text="You can restore deleted items from the Recycle Bin."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Select all" Margin="0,0,6,0" Click="SelectAll_Click" />
                            <Button Content="Select none" Margin="0,0,12,0" Click="SelectNone_Click" />
                            <Button Content="Cancel" Margin="0,0,8,0" Padding="16,7" Click="Cancel_Click" />
                            <Button x:Name="DeleteBtn" Content="Delete selected" Style="{StaticResource DangerButtonStyle}"
                                    Padding="18,7" Click="Delete_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
